# Copy to .env and edit. Read by bin/launch.sh and bin/janitor.sh.
# The agents themselves are configured in .claude/workflows/swarm-build.js —
# TARGET here MUST match CONFIG.target there (launch.sh enforces it).

# Absolute path to the repo the swarm builds. Must be its own git repo.
TARGET=/absolute/path/to/target-repo
# Absolute path for worker worktrees. Must be OUTSIDE TARGET.
WT=/absolute/path/to/target-repo-wt

# tmux session name, and the workflow file basename in .claude/workflows/.
SESSION=swarm
WORKFLOW=swarm-build
# Remote Control name — this is what you look for in the Claude mobile app.
REMOTE_NAME=swarm-runner
# The runner itself is a cheap supervisor; the workflow picks the real models.
RUNNER_MODEL=sonnet

# Tag prefix the scribe writes per green wave; resume reads the highest one.
TAG_PREFIX=round-
# Worker branch prefix. Must match CONFIG.branchPrefix in the workflow.
BRANCH_PREFIX=task

# Heartbeat period in seconds (Monitor tick -> resume/status turn).
HEARTBEAT_S=1800
# Janitor: sweep period, and the build dir to strip from idle worktrees.
JANITOR_INTERVAL=900
BUILD_DIR=node_modules

# Absolute binary paths — resolved from PATH if unset. Set these if your shell
# plugins wrap the command (e.g. an oh-my-zsh tmux wrapper).
# CLAUDE_BIN=/opt/homebrew/bin/claude
# TMUX_BIN=/opt/homebrew/bin/tmux
